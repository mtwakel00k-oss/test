# Copy this file to .env.local and fill in your values
# Get these from your Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://icefntwfwvtonkdyshde.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Choose any secret string for cron authentication
CRON_SECRET=your-cron-secret

# Root owner password (for POST /api/auth/setup-root)
# DEV_ROOT_PASSWORD=RootAdmin@123

# Default passwords for fast setup (JSON format — keys are tenant slugs)
# DEV_PASSWORDS={"burger-house":{"admin":"Admin123","cashier":"Cashier123","chef":"Chef1234"},"developer":{"admin":"Admin123","cashier":"Cashier123","chef":"Chef1234"}}

# Evolution API (self-hosted WhatsApp — no Meta Developer Portal needed)
# EVOLUTION_API_URL=https://evolution-api.onrender.com
# EVOLUTION_API_KEY=your-evolution-api-key
# EVOLUTION_INSTANCE=burger-house
# Per‑tenant instance name can also be stored in the `tenants.evolution_instance` column
